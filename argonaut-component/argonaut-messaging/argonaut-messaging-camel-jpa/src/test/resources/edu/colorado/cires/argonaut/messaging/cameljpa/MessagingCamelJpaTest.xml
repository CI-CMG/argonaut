<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring
       http://camel.apache.org/schema/spring/camel-spring.xsd">



  <!-- This wraps the native entity manager in a Spring specific transaction aware proxy.  This is required for Camel JPA.-->
  <bean id="entityManagerFactory" class="org.springframework.orm.jpa.LocalEntityManagerFactoryBean">
    <constructor-arg value="argonaut-messaging"/>
    <property name="jpaPropertyMap">
      <map>
        <entry key="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
        <entry key="jakarta.persistence.jdbc.url" value="jdbc:h2:./target/queue"/>
        <entry key="jakarta.persistence.jdbc.user" value="sa"/>
        <entry key="jakarta.persistence.jdbc.password" value=""/>
        <entry key="hibernate.hbm2ddl.auto" value="update"/>
      </map>
    </property>
  </bean>

  <bean id="platformTransactionManager" class="org.springframework.orm.jpa.JpaTransactionManager">
    <constructor-arg ref="entityManagerFactory"/>
  </bean>

  <bean id="transactionTemplate" class=" org.springframework.transaction.support.TransactionTemplate" >
    <constructor-arg ref="platformTransactionManager"/>
  </bean>

  <bean id="transactionStrategy" class="org.apache.camel.component.jpa.DefaultTransactionStrategy">
    <constructor-arg><null/></constructor-arg>
    <constructor-arg ref="entityManagerFactory"/>
    <property name="transactionManager" ref="platformTransactionManager"/>
  </bean>

  <!-- Default values for all Camel JPA endpoints.  Can also specify values on each endpoint if multiple DBs are used.-->
  <bean id="jpa" class="org.apache.camel.component.jpa.JpaComponent">
    <property name="entityManagerFactory" ref="entityManagerFactory"/>
    <property name="transactionStrategy" ref="transactionStrategy"/>
  </bean>

  <bean id="jsonMessageTranslator" class="edu.colorado.cires.argonaut.messaging.cameljpa.DefaultCamelJpaMessageTranslator"/>


  <bean id="testQueue" class="edu.colorado.cires.argonaut.messaging.cameljpa.CamelJpaParameterFactory" factory-method="queueParameter">
    <constructor-arg value="test-queue"/>
  </bean>

  <camelContext id="argonaut-camel" xmlns="http://camel.apache.org/schema/spring">
    <template id="producerTemplate"/>
    <route id="sender">
      <from uri="seda:start"/>
      <bean ref="jsonMessageTranslator" method="send('test-queue', ${body})"/>
      <to uri="jpa:edu.colorado.cires.argonaut.messaging.cameljpa.ArgonautMessageEntity?flushOnSend=true"/>
    </route>
    <route id="receiver">
      <from uri="jpa:edu.colorado.cires.argonaut.messaging.cameljpa.ArgonautMessageEntity?maximumResults=10&amp;parameters=#testQueue&amp;namedQuery=dequeue"/>
      <bean ref="jsonMessageTranslator" method="receive"/>
      <to uri="mock:end"/>
    </route>
  </camelContext>

</beans>