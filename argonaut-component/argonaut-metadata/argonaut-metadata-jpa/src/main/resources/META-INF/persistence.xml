<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
  version="3.0">
  <persistence-unit name="argonaut-index">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgonautProfileMergeFileEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatCycleEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoDacEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatMetadataEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatProfileEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgonautSyntheticMergeMetadataEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgonautFileRemovedTimeEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatProfileParameterEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatTrajectoryEntity</class>
    <class>edu.colorado.cires.argonaut.metadata.jpa.entity.ArgoFloatTechnicalInfoEntity</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.url" value=""/>
      <property name="jakarta.persistence.jdbc.user" value=""/>
      <property name="jakarta.persistence.jdbc.password" value=""/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
<!--      <property name="hibernate.default_schema" value="public"/>-->
      <property name="hibernate.check_nullability" value="false"/>
    </properties>
  </persistence-unit>
</persistence>