<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring
       http://camel.apache.org/schema/spring/camel-spring.xsd">

  <routeContext id="dac-submission-routes" xmlns="http://camel.apache.org/schema/spring">

    <route id="aoml-dac-submission">
      <errorHandler>
        <deadLetterChannel deadLetterUri="seda:audit" onPrepareFailureRef="prepareErrorAuditProcessor"/>
      </errorHandler>
      <from uri="file:{{dac.submission.directory}}/dac/aoml/submit?readLock=changed&amp;delete=true&amp;maxMessagesPerPoll=10&amp;shuffle=true"/>
      <setHeader name="AuditEventProcessor">
        <constant>FILE_RECEIVED</constant>
      </setHeader>
      <bean ref="fileToSubmissionMessage" method="convert(${body}, 'aoml')"/>
      <bean ref="auditSender" method="fileReceived"/>
      <bean ref="moveSubmitToProcessingProcessor" method="moveToProcessing"/>
      <bean ref="serializationProcessor" method="serialize"/>
      <to uri="seda:submit-work"/>
    </route>
    <route id="aoml-dac-submission-report">
      <from uri="cron:aoml-report-cron?schedule={{dac.report.cron}}"/>
      <bean ref="submissionReportTrigger" method="trigger('aoml')"/>
    </route>
    <route id="aoml-submitted-cleanup">
      <from uri="cron:aoml-submitted-cleanup-cron?schedule={{submitted-cleanup.cron}}"/>
      <bean ref="submissionCleanupProcessor" method="trigger('aoml', {{submitted-cleanup.older-than-days}})"/>
    </route>
    <route id="aoml-rejected-cleanup">
      <from uri="cron:aoml-rejected-cleanup-cron?schedule={{rejected-cleanup.cron}}"/>
      <bean ref="rejectedSubmissionCleanupProcessor" method="trigger('aoml', {{rejected-cleanup.older-than-days}})"/>
    </route>

