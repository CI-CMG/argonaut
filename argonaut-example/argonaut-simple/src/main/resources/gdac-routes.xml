<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring
       http://camel.apache.org/schema/spring/camel-spring.xsd">

  <routeContext id="gdac-routes" xmlns="http://camel.apache.org/schema/spring">

    <route id="dac-submission-work">
      <from uri="seda:submit-work"/>
      <bean ref="deserializationProcessor"
        method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.DacSubmittedFileMessage)"/>
      <bean ref="submitFileRouter" method="choice"/>
    </route>

    <route id="validate-submission">
      <from uri="seda:validation"/>
      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.NcSubmissionMessage)"/>
      <bean ref="validationProcessor" method="validate"/>
      <bean ref="validationResultRouter" method="route"/>
    </route>

    <route id="validation-success">
      <from uri="seda:validation-success"/>
      <to uri="seda:file-output"/>
    </route>

    <route id="file-output">
      <from uri="seda:file-output"/>
      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.NcSubmissionMessage)"/>
      <bean ref="fileMoveProcessor" method="moveFile"/>
      <bean ref="serializationProcessor" method="serialize"/>
      <to uri="seda:file-moved"/>
    </route>

    <route id="file-moved">
      <from uri="seda:file-moved"/>
      <multicast>
        <to uri="seda:submission-report"/>
        <to uri="seda:submission-index-transform"/>
      </multicast>
    </route>

    <route id="submission-report-update">
      <from uri="seda:submission-report"/>
      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.NcSubmissionMessage)"/>
      <bean ref="submissionReportAppender" method="appendReport"/>
    </route>

    <route id="submission-index-transform">
      <from uri="seda:submission-index-transform"/>
      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.NcSubmissionMessage)"/>
      <bean ref="metadataTransformProcessor" method="transformNcSubmissionMessage"/>
      <bean ref="serializationProcessor" method="serialize"/>
      <to uri="seda:update-index"/>
    </route>

    <route id="update-index">
      <from uri="seda:update-index"/>
      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.MetadataRecord"/>
      <bean ref="updateIndexProcessor" method="updateIndex"/>
    </route>

    <route id="float-merge-cron">
      <from uri="cron:float-merge-cron?schedule={{float-merge.cron}}"/>
      <bean ref="floatMergeAggregator" method="trigger"/>
    </route>

    <route id="float-merge">
      <from uri="seda:float-merge"/>
      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.FloatMergeGroup"/>
      <bean ref="floatMergeProcessor" method="merge" />
    </route>

    <route id="synthetic-profile-cron">
      <from uri="cron:synthetic-profile-cron?schedule={{synthetic-profile.cron}}"/>
      <bean ref="syntheticProfileAggregator" method="trigger"/>
    </route>

<!--    <route id="synthetic-profile">-->
<!--      <from uri="seda:synthetic-profile"/>-->
<!--      <bean ref="deserializationProcessor" method="deserialize(${body}, edu.colorado.cires.argonaut.messaging.core.databind.ProfileOperation"/>-->
<!--      <bean ref="syntheticProfileProcessor" method="generateSyntheticProfile" />-->
<!--    </route>-->

  </routeContext>

</beans>