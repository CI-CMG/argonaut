<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring
       http://camel.apache.org/schema/spring/camel-spring.xsd">

  <!-- Import the original configuration -->
  <import resource="classpath:/application-context.xml"/>

  <!-- Override the specific bean with a new definition -->

  <bean id="propertiesLoader" class="org.apache.camel.spring.spi.BridgePropertyPlaceholderConfigurer">
    <property name="locations">
      <list>
        <value>classpath:argonaut-default.properties</value>
        <value>classpath:/edu/colorado/cires/argonaut/standalone/argonaut-test.properties</value>
      </list>
    </property>
    <property name="ignoreResourceNotFound" value="true"/>
  </bean>


  <bean id="fileToSubmissionMessage" class="edu.colorado.cires.argonaut.standalone.FileToSubmissionMessage">
    <property name="timestampGenerator">
      <bean class="edu.colorado.cires.argonaut.standalone.StaticTimestampGenerator"/>
    </property>
    <property name="traceIdGenerator">
      <bean class="edu.colorado.cires.argonaut.standalone.StaticTraceIdGenerator"/>
    </property>
  </bean>

  <bean id="floatMergeProcessor" class="org.mockito.Mockito" factory-method="mock">
    <constructor-arg type="java.lang.Class" value="edu.colorado.cires.argonaut.processor.core.DefaultFloatMergeProcessor"/>
  </bean>

  <bean id="geoFilter" class="org.mockito.Mockito" factory-method="mock">
    <constructor-arg type="java.lang.Class" value="edu.colorado.cires.argonaut.processor.core.GeoFilter"/>
  </bean>

</beans>